# Core runtime
NODE_ENV=production
PORT=3000
KINGMYCO_STATE_PATH=data/kingmyco-state.json
KINGMYCO_ADMIN_KEY=replace-with-long-admin-key

# Optional source auth map (JSON string)
# KINGMYCO_SOURCE_AUTH_JSON={"kingmyco.io":{"token":"replace","scopes":["identity:write","run:generate","session:write","solana:verify","solana:reward:prepare"]}}

# Webhook verification secrets
KINGMYCO_TELEGRAM_WEBHOOK_SECRET=replace-telegram-secret
OPENCLAW_WEBHOOK_SECRET=replace-openclaw-secret

# Solana RPC and wallet-link settings
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
KINGMYCO_SOLANA_CHALLENGE_TTL_MS=600000

# Treasury signer mode (local-secret or remote-hsm)
KINGMYCO_TREASURY_SIGNER_MODE=local-secret
KINGMYCO_TREASURY_WALLET=replace-solana-wallet
KINGMYCO_TREASURY_SECRET=replace-base58-or-json-secret
KINGMYCO_TREASURY_SIGNER_ENDPOINT=
KINGMYCO_TREASURY_SIGNER_BEARER_TOKEN=
KINGMYCO_TREASURY_SIGNER_TIMEOUT_MS=10000

# Optional external persistence
KINGMYCO_PG_URL=
KINGMYCO_REDIS_URL=

# Settlement worker tuning
KINGMYCO_SETTLEMENT_POLL_MS=7000
KINGMYCO_SETTLEMENT_PREPARED_BATCH=15
KINGMYCO_SETTLEMENT_SUBMITTED_BATCH=30
KINGMYCO_SETTLEMENT_DRY_RUN=false

# Heartbeat worker tuning
KINGMYCO_HEARTBEAT_POLL_MS=60000
KINGMYCO_HEARTBEAT_SOURCES=mycokingdom_bot,mycoai_bot,kingdom.kingmyco.com,kingmyco.io,openclaw
KINGMYCO_HEARTBEAT_EVENT_NAME=ecosystem_heartbeat
KINGMYCO_HEARTBEAT_INSTANCE=kingmyco-prod-1
KINGMYCO_HEARTBEAT_DRY_RUN=false
